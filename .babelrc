{
    "presets": [["@babel/preset-env", {
        "targets": {
          "node": "current"
        }
    }]],
    "plugins": [
      "@babel/transform-runtime",
      "@babel/plugin-proposal-class-properties",
      ["module-resolver", {
        "root": ["./src"],
        "alias": {
          "@config": "./src/config",
          "@mocks": "./src/mocks",
          "@api": "./src"

        }
      }]
    ]
}